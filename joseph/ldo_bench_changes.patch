--- a/ldo_bench/tests/test_line_tran.py
+++ b/ldo_bench/tests/test_line_tran.py
@@ -69,3 +69,77 @@ def test_line_tran_rejection_by_hand():
     m = SettlingResult(1.2, 1.205, 5e-4, 1.2, 1e-5, 1e-5, 1.2, 10e6, 100, "pre")  # +5 mV kick
     e = line_tran.EdgeResult("rising", 1.75, 1.85, m, np.zeros(1), np.zeros(1), np.zeros(1), np.zeros(1))
     assert e.rejection == pytest.approx(0.005 / 0.1)  # 50 mV per V of VIN step
+
+
+def test_small_vin_step_triggers_on_50v_range(jafwak):
+    """Bench, 2026-11-18: with [ad2] ref on the 50 V range the AD2's default trigger hysteresis is 0.5 V,
+    so a 100 mV VIN step never triggered. line-tran must set its own hysteresis (and use the fine range)."""
+    assert jafwak.ad2.ref.range == 50.0  # the config that failed on the bench
+    res, _ = run(jafwak)
+    assert not res.issues, res.issues
+    for e in res.edges:
+        assert e.metrics.step_index >= 0
+
+
+def test_sim_trigger_needs_hysteresis_before_the_edge(jafwak):
+    """The simulated scope, like the AD2, ignores a crossing that doesn't start `hysteresis` below the level."""
+    from ldo_bench.instruments.base import ChannelSetup, InstrumentError
+
+    with open_bench(jafwak, sim=True) as b:
+        m, ch = b.sim_model, jafwak.ad2.ref_channel
+        setups = {1: ChannelSetup(5.0, 0.0), ch: ChannelSetup(50.0, 0.0)}
+
+        m.psu_to, m.psu_on = "vin", True  # sim VIN = the PSU setpoint
+
+        def capture(hysteresis):
+            m.psu_v = 1.75
+
+            def step():
+                m.psu_v = 1.85
+
+            return b.scope.capture(
+                sample_rate=1e6,
+                n_samples=1000,
+                setups=setups,
+                trigger_channel=ch,
+                trigger_level=1.8,
+                edge="rising",
+                pre_trigger=0.2,
+                stimulus=step,
+                timeout=1.0,
+                hysteresis=hysteresis,
+            )
+
+        with pytest.raises(InstrumentError, match="trigger timeout"):
+            capture(None)  # default: 1 % of 50 V = 0.5 V, more than the 100 mV step
+        assert capture(0.025).edge_found
+
+
+def test_square_refuses_levels_above_vin_max(jafwak):
+    from ldo_bench.instruments.base import InstrumentError
+
+    with open_bench(jafwak, sim=True) as b:
+        with pytest.raises(InstrumentError, match="refusing"):
+            b.vin_square_from_wavegen(low=1.75, high=jafwak.dut.vin_max + 0.05, frequency=20)
+        with pytest.raises(InstrumentError, match="refusing"):
+            b.vin_square_from_wavegen(low=1.85, high=1.75, frequency=20)
+        assert b.sim_model.awg_wave == {}  # nothing reached the wavegen
+
+
+def test_square_mode_runs_and_ends_on_dc(jafwak):
+    """--square-hz: W1 runs a square between the calibrated setpoints, then is back on DC before shutdown."""
+    lt = jafwak.line_tran.model_copy(update={"averages": 2})
+    seen = []
+    with open_bench(jafwak, sim=True) as b:
+        real = b.awg.set_wave
+
+        def spy(ch, **kw):
+            seen.append(kw)
+            real(ch, **kw)
+
+        b.awg.set_wave = spy
+        res = line_tran.run(b, lt, jafwak.analysis, square_hz=20)
+        assert b.sim_model.awg_wave == {}  # back on DC (then off) by the end
+    assert len(seen) == 1 and seen[0]["shape"] == "square" and seen[0]["frequency"] == 20
+    assert seen[0]["low"] == pytest.approx(res.w1_low) and seen[0]["high"] == pytest.approx(res.w1_high)
+    assert res.summary()["square_hz"] == 20
